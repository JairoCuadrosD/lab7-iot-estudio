<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: el backend local corre en http (sin TLS) -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lab7"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ListaActivity"
            android:label="Mis sesiones" />

        <activity
            android:name=".FormSesionActivity"
            android:label="Sesión de estudio"
            android:parentActivityName=".ListaActivity" />

        <activity
            android:name=".GraficosActivity"
            android:label="Gráficos"
            android:parentActivityName=".ListaActivity" />
    </application>
</manifest>
